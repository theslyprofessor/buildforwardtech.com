          <div class="grid sm:grid-cols-3 gap-4 text-xs">
            <div class="p-4 rounded-xl border border-sky-500/30 bg-background/80">
              <div class="font-bold text-sky-400 text-sm mb-1">macOS 14+</div>
              <div class="text-muted-foreground leading-relaxed">
                Native Apple Silicon &amp; Intel menu bar + desktop app (<code>ScreenStage.app</code>) with 1-click updates and bug reporting.
              </div>
            </div>
            <div class="p-4 rounded-xl border border-emerald-500/30 bg-background/80">
              <div class="font-bold text-emerald-400 text-sm mb-1">Windows 10 &amp; 11</div>
              <div class="text-muted-foreground leading-relaxed">
                Standalone zero-dependency Windows app (<code>ScreenStage.exe</code>) with full KVM switch and HDMI TV support.
              </div>
            </div>
            <div class="p-4 rounded-xl border border-purple-500/30 bg-background/80">
              <div class="font-bold text-purple-400 text-sm mb-1">Linux (x64 &amp; ARM64)</div>
              <div class="text-muted-foreground leading-relaxed">
                Native support for X11 (<code>xrandr</code>) and Wayland (<code>wlr-randr</code> / KDE) with hardware EDID monitor naming.
              </div>
            </div>
          </div>
        </div>
        <div class="lg:col-span-5 flex justify-center">
          <div class="w-[270px] rounded-3xl overflow-hidden border-2 border-sky-500/40 bg-black shadow-2xl shadow-sky-500/15">
            <video
              controls
              playsinline
              preload="metadata"
              class="w-full aspect-[9/16] block bg-slate-950"
            >
              <source src="/videos/displays-reel-9x16.mp4" type="video/mp4" />
            </video>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing & Licensing Section (Commercial Tiers Only — Downloads Unlock After Purchase) -->
  <section id="pricing" class="py-20 border-t border-border/60">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <Badge variant="outline" class="mb-3">Simple One-Time Pricing</Badge>
