---
import PageLayout from "@/layouts/PageLayout.astro";
import { Badge } from "@/components/ui/badge";
---

<PageLayout
  title="ScreenStage — Every Room Remembers Every Screen (Mac, Windows & Linux) | Build Forward Tech"
  description="Plug into any desk, studio, or conference room and ScreenStage automatically recognizes the room and sets every monitor, TV, and laptop screen in one click. Available for macOS, Windows 10/11, and Linux."
>
  <!-- Hero Section -->
  <section class="relative pt-28 pb-20 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-sky-500/10 via-background to-background pointer-events-none"></div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <!-- Clean Brand Pill with Custom App Icon -->
        <div class="inline-flex items-center justify-center gap-3 px-4 py-2 rounded-full bg-slate-900/90 border border-sky-500/30 text-sky-300 text-sm font-semibold mb-6 shadow-lg shadow-sky-500/10">
          <img src="/images/screenstage-icon.svg" alt="ScreenStage App Icon" class="w-7 h-7 rounded-lg" />
          <span class="text-white font-bold">ScreenStage v1.1</span>
          <span class="text-slate-500">•</span>
          <span>For Mac, Windows &amp; Linux</span>
        </div>

        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight mb-6 leading-[1.08]">
          Every Room Remembers<br />
          <span class="bg-gradient-to-r from-sky-400 to-emerald-400 bg-clip-text text-transparent">Every Screen.</span>
        </h1>

        <p class="text-lg sm:text-xl text-muted-foreground leading-relaxed mb-8">
          Stop dragging display boxes around in System Settings every time you plug into a dock, KVM switch, or room TV. <strong>ScreenStage</strong> automatically recognizes which room you are in, remembers every monitor you have ever plugged in, and switches your entire multi-screen layout in one click.
        </p>

        <!-- Purchase CTAs (Downloads gated behind purchase / license key) -->
        <div class="flex flex-wrap justify-center gap-4 mb-5">
          <button
            type="button"
            onclick="window.openDisplaysCheckout && window.openDisplaysCheckout('personal')"
            class="inline-flex items-center gap-2 px-7 py-4 rounded-xl bg-gradient-to-r from-sky-400 to-emerald-400 text-slate-950 font-extrabold text-base shadow-xl shadow-sky-500/25 hover:opacity-95 transition cursor-pointer"
          >
            Buy Personal License — $19
          </button>
          <button
            type="button"
            onclick="window.openDisplaysCheckout && window.openDisplaysCheckout('team')"
            class="inline-flex items-center gap-2 px-7 py-4 rounded-xl border-2 border-sky-400/50 bg-sky-500/10 text-white font-bold text-base hover:bg-sky-500/20 transition cursor-pointer"
          >
            Buy Studio &amp; Team Pack — $199 (15 Computers)
          </button>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs text-muted-foreground">
          <span>✓ One-time purchase (no subscription)</span>
          <span>•</span>
          <span>✓ Includes macOS, Windows 10/11 &amp; Linux downloads</span>
          <span>•</span>
          <button
            type="button"
            onclick="window.openDisplaysCheckout && window.openDisplaysCheckout('verify')"
            class="text-sky-400 underline hover:text-emerald-300 cursor-pointer"
          >
            Already have a license key? Unlock download →
          </button>
        </div>
      </div>

      <!-- 1080p 60fps Launch Video Player -->
      <div class="rounded-2xl overflow-hidden border border-sky-500/30 bg-slate-950 shadow-2xl shadow-sky-500/10">
        <video
          src="/videos/displays-launch.mp4"
          poster="/images/displays-multi-space.png"
          controls
          autoplay
          muted
          loop
          playsinline
          class="w-full aspect-video block"
        ></video>
        <div class="px-6 py-3.5 bg-slate-900/90 border-t border-white/10 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-300">
          <span>🎬 <strong>Watch ScreenStage in Action</strong> — Unmute player for audio</span>
          <span class="text-sky-400 font-semibold">macOS · Windows 10/11 · Linux (X11 &amp; Wayland)</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 Plain-English Benefits -->
  <section class="py-16 border-t border-border/60 bg-muted/20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <Badge variant="outline" class="mb-3">Why ScreenStage</Badge>
        <h2 class="text-3xl font-bold mb-4">Multi-Monitor Setups Without the Guesswork</h2>
        <p class="text-muted-foreground">
          Built for people who use multiple monitors, TVs, docks, or KVM switches across one or more rooms.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl border border-border bg-background">
          <div class="text-xs font-mono text-sky-400 font-bold mb-2">01 / AUTOMATIC ROOM DETECTION</div>
          <h3 class="text-lg font-bold mb-2">Plug In and It Knows the Room</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            ScreenStage recognizes each space by the monitors connected to your dock or KVM switch. Move from your Home Office to a Studio or Conference Room and your preset list switches automatically.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-border bg-background">
          <div class="text-xs font-mono text-emerald-400 font-bold mb-2">02 / CLEAR SCREEN ROLES</div>
          <h3 class="text-lg font-bold mb-2">Plain-English Presets &amp; Notes</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Every preset shows clear role badges for each screen (<code>MAIN</code>, <code>MIRROR</code>, <code>EXTEND</code>, or <code>OFF</code>). Click any monitor or room to edit its name and description in plain English.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-border bg-background">
          <div class="text-xs font-mono text-purple-400 font-bold mb-2">03 / SMART SCREEN HIDING</div>
          <h3 class="text-lg font-bold mb-2">Hide Screens You Aren't Using</h3>
          <p class="text-sm text-muted-foreground leading-relaxed">
            Laptop tucked away in a rack or closed on a shelf? Mark it hidden in that room so your presets stay clean, or turn one monitor off while keeping the rest of your setup working.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Adaptive UI Comparison: Multi-Room vs Single-Room Mode -->
  <section class="py-16 border-t border-border/60">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <Badge variant="outline" class="mb-3">Adapts to Your Computer</Badge>
        <h2 class="text-3xl font-bold mb-4">Works on Roaming Laptops and Fixed Desktops</h2>
        <p class="text-muted-foreground">
          Whether you carry a laptop between locations or run a dedicated desktop workstation in one room, ScreenStage adapts its interface automatically.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 items-start">
        <div class="rounded-2xl border border-border bg-card/50 p-6">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-mono uppercase tracking-wider text-sky-400 font-semibold">For Laptops</span>
            <span class="text-xs px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 font-medium">Multi-Room Tabs</span>
          </div>
          <h3 class="text-xl font-bold mb-2">Switch Spaces Automatically as You Travel</h3>
          <p class="text-sm text-muted-foreground mb-5 leading-relaxed">
            Keep separate presets for your Home Desk, Office, Studio, and Living Room TV. ScreenStage highlights the active room with a green dot the moment you plug in and remembers monitors even when they are unplugged.
          </p>
          <img
            src="/images/displays-multi-space.png"
            alt="ScreenStage Multi-Room Mode"
            class="w-full rounded-xl border border-white/10 shadow-lg"
          />
        </div>

        <div class="rounded-2xl border border-border bg-card/50 p-6">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-mono uppercase tracking-wider text-purple-400 font-semibold">For Desktops</span>
            <span class="text-xs px-2.5 py-0.5 rounded-full bg-purple-500/10 text-purple-400 font-medium">Single-Room View</span>
          </div>
          <h3 class="text-xl font-bold mb-2">Zero Clutter for Dedicated Workstations</h3>
          <p class="text-sm text-muted-foreground mb-5 leading-relaxed">
            A desktop PC or studio Mac that never leaves its desk doesn't need tabs for other rooms. ScreenStage automatically hides room tabs when you only use one space, showing just your monitors and 1-click presets.
          </p>
          <img
            src="/images/displays-single-space.png"
            alt="ScreenStage Single-Room Desktop Mode"
            class="w-full rounded-xl border border-white/10 shadow-lg"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Cross-Platform Support + Mobile Reel Preview -->
  <section class="py-16 border-t border-border/60 bg-slate-950/50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7">
