              Pay $19 — Personal License (3 Seats) →
            </button>
            <button
              type="button"
              onclick="window.startProviderCheckout('team')"
              class="py-3 px-3 rounded-xl bg-emerald-400 hover:bg-emerald-300 text-slate-950 font-extrabold text-xs transition cursor-pointer"
            >
              Pay $199 — Studio &amp; Team Pack (15 Seats) →
            </button>
          </div>
        </div>

        <div class="border-t border-white/10 pt-3 mt-3">
          <div class="text-xs font-semibold text-slate-300 mb-1.5">Already purchased a license key?</div>
          <div class="flex gap-2">
            <input
              id="existingLicenseInput"
              type="text"
              placeholder="Paste MM1-... license key to unlock downloads"
              class="flex-1 rounded-lg border border-white/15 bg-slate-900 px-3 py-1.5 text-xs font-mono text-white focus:border-sky-400 focus:outline-none"
            />
            <button
              type="button"
              onclick="window.unlockWithExistingKey()"
              class="px-3.5 py-1.5 rounded-lg border border-sky-400/50 bg-sky-500/15 text-sky-200 font-bold text-xs hover:bg-sky-500/25 transition cursor-pointer"
