        <p class="text-muted-foreground">
          No recurring subscriptions. Your license key and installers for macOS, Windows, and Linux unlock immediately after checkout.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- Personal License Card ($19) -->
        <div class="rounded-2xl border-2 border-sky-400 bg-gradient-to-b from-sky-500/10 to-transparent p-8 flex flex-col justify-between shadow-xl shadow-sky-500/10">
          <div>
            <div class="flex items-center justify-between mb-2">
