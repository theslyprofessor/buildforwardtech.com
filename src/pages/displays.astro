            Buy Personal License ($19) →
          </button>
        </div>

        <!-- Studio & Team Pack Card ($79) -->
        <div class="rounded-2xl border border-emerald-400/50 bg-gradient-to-b from-emerald-500/10 to-transparent p-8 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono uppercase tracking-wider text-emerald-400 font-bold">
                Studio &amp; Team Pack
              </span>
              <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-emerald-400/20 text-emerald-300 border border-emerald-400/40">
                UP TO 15 COMPUTERS
              </span>
            </div>
            <div class="flex items-baseline gap-2 mb-4">
              <span class="text-4xl font-extrabold">$199</span>
              <span class="text-sm text-muted-foreground">one-time · studios, labs &amp; production teams</span>
            </div>
            <p class="text-sm text-muted-foreground mb-6 leading-relaxed">
              Standardize multi-monitor rooms across recording studios, classrooms, edit bays, and shared workstations.
            </p>
            <ul class="space-y-2.5 text-sm mb-8">
              <li>✓ Activate on up to <strong>15 studio, lab, or office computers</strong></li>
              <li>✓ Single-Room Desktop mode for dedicated room machines</li>
              <li>✓ Share room presets across macOS, Windows &amp; Linux workstations</li>
              <li>✓ Commercial invoice + ACH / Purchase Order support</li>
            </ul>
          </div>
          <button
            type="button"
            onclick="window.openDisplaysCheckout && window.openDisplaysCheckout('team')"
            class="block w-full py-3.5 px-4 rounded-xl border-2 border-emerald-400 bg-emerald-500/15 text-white text-center font-bold text-sm hover:bg-emerald-500/25 transition cursor-pointer"
          >
            Buy Studio &amp; Team Pack ($199) →
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Gated Checkout & License Verification Modal -->
  <div
    id="displaysCheckoutModal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-sm p-4"
  >
    <div class="w-full max-w-lg rounded-2xl border border-sky-500/40 bg-slate-950 p-6 shadow-2xl">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-3">
          <img src="/images/screenstage-icon.svg" alt="ScreenStage" class="w-9 h-9 rounded-lg" />
          <div>
            <span class="text-[11px] font-mono uppercase tracking-wider text-sky-400 font-bold">
              ScreenStage v1.1 · Instant Delivery
            </span>
            <h3 id="checkoutModalTitle" class="text-xl font-bold text-white">Get ScreenStage License</h3>
          </div>
        </div>
        <button
          type="button"
          onclick="window.closeDisplaysCheckout()"
          class="text-slate-400 hover:text-white text-lg font-bold px-2 cursor-pointer"
        >
          ✕
        </button>
      </div>

      <!-- Purchase Form View -->
      <div id="checkoutPurchaseView">
        <p class="text-xs text-slate-300 mb-4 leading-relaxed">
          Your license key and installer downloads for <strong>macOS</strong>, <strong>Windows 10/11</strong>, and <strong>Linux</strong> unlock immediately upon purchase.
        </p>

        <div class="space-y-3 mb-4">
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Email Address (for License Key &amp; Receipt)</label>
            <input
              id="checkoutEmailInput"
              type="email"
              required
              placeholder="you@example.com"
              class="w-full rounded-lg border border-white/15 bg-slate-900 px-3.5 py-2.5 text-sm text-white focus:border-sky-400 focus:outline-none"
            />
            <div id="checkoutEmailError" class="hidden text-xs text-rose-400 mt-1">
              Please enter a valid email address to continue.
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-2">
            <button
              type="button"
              onclick="window.startProviderCheckout('personal')"
              class="py-3 px-3 rounded-xl bg-sky-400 hover:bg-sky-300 text-slate-950 font-extrabold text-xs transition cursor-pointer"
