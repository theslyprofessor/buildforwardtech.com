---
import PageLayout from "@/layouts/PageLayout.astro";
import { Badge } from "@/components/ui/badge";
---

<PageLayout
  title="Displays for macOS — Native Multi-Monitor History & Room Presets | Build Forward Tech"
  description="Every room remembers every screen. Native SwiftUI macOS menu bar & desktop utility with hardware UUID room detection, per-space monitor history, self-explanatory role badges, and CLI automation."
>
  <!-- Hero + Launch Video Section -->
  <section class="relative pt-28 pb-20 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-sky-500/10 via-background to-background pointer-events-none"></div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <div class="inline-flex flex-wrap items-center justify-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-500/10 border border-sky-500/30 text-sky-400 text-xs font-semibold uppercase tracking-wider mb-6">
          <span>BFT Labs × <a href="https://musicmind.biz#products" target="_blank" rel="noopener noreferrer" class="underline hover:text-emerald-300">MusicMind.biz</a> Release · v1.0</span>
          <span>•</span>
          <span>macOS 14+ (SwiftUI) &amp; Windows 10/11 (Win32 CCD)</span>
        </div>
        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight mb-6">
          Every Room Remembers <span class="bg-gradient-to-r from-sky-400 to-emerald-400 bg-clip-text text-transparent">Every Screen.</span>
        </h1>
        <p class="text-lg sm:text-xl text-muted-foreground leading-relaxed mb-8">
          <strong>Displays</strong> is a standalone native macOS and Windows multi-monitor engine built by <strong>Build Forward Tech Labs</strong> in affiliation with <a href="https://musicmind.biz#products" target="_blank" rel="noopener noreferrer" class="text-sky-400 underline hover:text-emerald-400">MusicMind</a>. It auto-detects homes, studios, and classrooms by hardware screen UUIDs, tracks every monitor's history (including KVM switches &amp; TVs), hides remote machine-room screens, and switches arrangements in one click.
        </p>

        <div class="flex flex-wrap justify-center gap-3">
          <button
            type="button"
            onclick="window.openDisplaysCheckout && window.openDisplaysCheckout()"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-gradient-to-r from-sky-400 to-emerald-400 text-slate-950 font-bold text-sm shadow-lg shadow-sky-500/20 hover:opacity-95 transition cursor-pointer"
          >
            Buy License — $19 (Stripe / LemonSqueezy)
          </button>
          <a
            href="/releases/Displays-macOS-v1.0.0.zip"
            download
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl border border-sky-400/50 bg-sky-500/15 text-sky-200 font-bold text-sm hover:bg-sky-500/25 transition"
          >
            Download macOS (.app)
          </a>
          <a
            href="/releases/Displays-Windows-v1.0.0.zip"
            download
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl border border-emerald-400/50 bg-emerald-500/15 text-emerald-200 font-bold text-sm hover:bg-emerald-500/25 transition"
          >
            Download Windows 10/11 (.exe)
          </a>
          <a
            href="https://github.com/theslyprofessor/displays"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl border border-border bg-background/80 hover:border-sky-500/50 text-sm font-semibold transition"
          >
            View Open Source on GitHub
          </a>
        </div>
      </div>

      <!-- 1080p 60fps Launch Video Player -->
      <div class="rounded-2xl overflow-hidden border border-sky-500/30 bg-slate-950 shadow-2xl shadow-sky-500/10">
        <video
          src="/videos/displays-launch.mp4"
          poster="/images/displays-multi-space.png"
          controls
          autoplay
          muted
          loop
          playsinline
          class="w-full aspect-video block"
        ></video>
        <div class="px-6 py-3 bg-slate-900/90 border-t border-white/10 flex flex-wrap items-center justify-between gap-2 text-xs text-muted-foreground">
          <span>🎬 <strong>Displays for macOS Launch Reel</strong> — Rendered programmatically in 1080p60 with Remotion 4 (unmute player for synthwave soundtrack)</span>
          <span class="font-mono text-sky-400">~/.config/displays/presets.json</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Adaptive UI Comparison: Multi-Room vs Single-Space Desktop -->
  <section class="py-16 border-t border-border/60">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <Badge variant="outline" class="mb-3">Adaptive Architecture</Badge>
        <h2 class="text-3xl font-bold mb-4">Built for Roaming Laptops and Fixed Studio Macs</h2>
        <p class="text-muted-foreground">
          A fixed desktop in Studio A does not need tabs for other rooms. Displays adapts automatically to how each machine works.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 items-start">
        <div class="rounded-2xl border border-border bg-card/50 p-6">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-mono uppercase tracking-wider text-sky-400 font-semibold">Multi-Room Laptop Mode</span>
            <span class="text-xs px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 font-medium">Auto-Detects Room by UUID</span>
          </div>
          <h3 class="text-xl font-bold mb-2">Instant Space Recognition + Hidden Screens</h3>
          <p class="text-sm text-muted-foreground mb-5">
            When you plug your MacBook into a studio or lecture hall, Displays matches the external monitor UUIDs against your spaces (e.g. <code>84-101</code>, <code>84-102</code>, <code>84-105</code>). If your laptop sits closed in a separate machine room, mark it <strong>Hidden</strong> in that space so preset chips only show the monitors you actually see.
          </p>
          <img
            src="/images/displays-multi-space.png"
            alt="Displays Multi-Space Mode"
            class="w-full rounded-xl border border-white/10 shadow-lg"
          />
        </div>

        <div class="rounded-2xl border border-border bg-card/50 p-6">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-mono uppercase tracking-wider text-purple-400 font-semibold">Single-Space Desktop Mode</span>
            <span class="text-xs px-2.5 py-0.5 rounded-full bg-purple-500/10 text-purple-400 font-medium">Zero Room Clutter</span>
          </div>
          <h3 class="text-xl font-bold mb-2">Clean Single-Room View for Fixed Machines</h3>
          <p class="text-sm text-muted-foreground mb-5">
            On a dedicated studio desktop or home workstation with a single space, multi-room tabs disappear automatically. Every monitor ever connected is logged in the space's <strong>Monitor History</strong> with editable names, notes, and one-click role presets.
          </p>
          <img
            src="/images/displays-single-space.png"
            alt="Displays Single-Space Desktop Mode"
            class="w-full rounded-xl border border-white/10 shadow-lg"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Pillars -->
  <section class="py-16 border-t border-border/60 bg-muted/20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="p-6 rounded-xl border border-border bg-background">
          <div class="text-xs font-mono text-sky-400 font-bold mb-2">01 / SELF-EXPLANATORY CHIPS</div>
          <h3 class="text-lg font-bold mb-2">Visual Monitor Role Pills</h3>
          <p class="text-sm text-muted-foreground">
            Every preset parses its underlying layout into visual per-monitor chips (<code>MAIN</code>, <code>MIRROR</code>, <code>EXTEND</code>, <code>OFF</code>) alongside plain-English descriptions you can edit anytime.
          </p>
        </div>

        <div class="p-6 rounded-xl border border-border bg-background">
          <div class="text-xs font-mono text-emerald-400 font-bold mb-2">02 / MONITOR HISTORY</div>
          <h3 class="text-lg font-bold mb-2">Persistent Space Inventory</h3>
          <p class="text-sm text-muted-foreground">
            Click any monitor in a space to rename it (e.g. <code>C27-30 (2) · Main Desk</code> or <code>TV (Blackmagic) · Room TV</code>), record which machine owns which screen, or hide unseen screens.
          </p>
        </div>

        <div class="p-6 rounded-xl border border-border bg-background">
          <div class="text-xs font-mono text-purple-400 font-bold mb-2">03 / DOTFILES & CLI</div>
          <h3 class="text-lg font-bold mb-2">Git-Friendly JSON + CLI</h3>
          <p class="text-sm text-muted-foreground">
            All spaces, monitor histories, and presets live in a single clean <code>~/.config/displays/presets.json</code> file and can be triggered from scripts via <code>displays apply</code>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing & Download Section -->
  <section id="pricing" class="py-20 border-t border-border/60">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <Badge variant="outline" class="mb-3">Pricing & Licensing</Badge>
        <h2 class="text-3xl sm:text-4xl font-bold mb-4">Own the Signed macOS App or Build from Source</h2>
        <p class="text-muted-foreground">
          Zero subscriptions. No telemetry. Standalone native SwiftUI executable.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- Open Source Card -->
        <div class="rounded-2xl border border-border bg-background p-8 flex flex-col justify-between">
          <div>
            <div class="text-xs font-mono uppercase tracking-wider text-muted-foreground font-semibold mb-2">
              Open Source Edition
            </div>
            <div class="flex items-baseline gap-2 mb-4">
              <span class="text-4xl font-extrabold">$0</span>
              <span class="text-sm text-muted-foreground">/ build from source</span>
            </div>
            <p class="text-sm text-muted-foreground mb-6">
              Full Swift 6 / SwiftUI source code and CLI script. Compile locally on macOS 14+ with Xcode Command Line Tools and <code>displayplacer</code>.
            </p>
            <ul class="space-y-2.5 text-sm text-muted-foreground mb-8">
              <li>✓ Complete SwiftUI + AppKit source code</li>
              <li>✓ Companion <code>displays</code> terminal CLI</li>
              <li>✓ Stowed <code>~/.config/displays/presets.json</code> schema</li>
            </ul>
          </div>
          <a
            href="https://github.com/theslyprofessor/displays"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-3 px-4 rounded-xl border border-border text-center font-semibold text-sm hover:border-primary/50 transition"
          >
            Clone on GitHub →
          </a>
        </div>

        <!-- Paid Signed Bundle Card -->
        <div class="rounded-2xl border-2 border-sky-400 bg-gradient-to-b from-sky-500/10 to-emerald-500/5 p-8 flex flex-col justify-between shadow-xl shadow-sky-500/10">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono uppercase tracking-wider text-sky-400 font-bold">
                Signed macOS App + CLI Bundle
              </span>
              <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-sky-400 text-slate-950">
                v1.0 RELEASE
              </span>
            </div>
            <div class="flex items-baseline gap-2 mb-4">
              <span class="text-4xl font-extrabold">$19</span>
              <span class="text-sm text-muted-foreground">one-time license · all personal Macs &amp; Windows PCs</span>
            </div>
            <p class="text-sm text-muted-foreground mb-6">
              Ready-to-run, Apple Developer code-signed <code>Displays.app</code> bundle for macOS plus standalone zero-dependency <code>Displays.exe</code> for Windows 10/11 sharing the same <code>presets.json</code> monitor history schema.
            </p>
            <ul class="space-y-2.5 text-sm mb-8">
              <li>✓ Signed native <code>Displays.app</code> (macOS Apple Silicon &amp; Intel)</li>
              <li>✓ Native <code>Displays.exe</code> (Windows 10/11 Win32 CCD + KVM TV support)</li>
              <li>✓ Auto-detects multi-monitor rooms + Single-Space desktop mode</li>
              <li>✓ Direct download + commercial invoice for studio/institutional seats</li>
            </ul>
          </div>
          <div class="space-y-3">
            <button
              type="button"
              onclick="window.openDisplaysCheckout && window.openDisplaysCheckout()"
              class="block w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-sky-400 to-emerald-400 text-slate-950 text-center font-bold text-sm hover:opacity-95 transition cursor-pointer shadow-lg shadow-sky-500/20"
            >
              Buy License via Stripe / LemonSqueezy ($19) →
            </button>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              <a
                href="/releases/Displays-macOS-v1.0.0.zip"
                download
                class="block w-full py-2.5 px-4 rounded-xl border border-sky-400/50 bg-sky-500/15 text-sky-200 text-center font-bold text-xs hover:bg-sky-500/25 transition"
              >
                Direct Download macOS (.app)
              </a>
              <a
                href="/releases/Displays-Windows-v1.0.0.zip"
                download
                class="block w-full py-2.5 px-4 rounded-xl border border-emerald-400/50 bg-emerald-500/15 text-emerald-200 text-center font-bold text-xs hover:bg-emerald-500/25 transition"
              >
                Direct Download Windows (.exe)
              </a>
            </div>
            <div class="flex items-center justify-between text-xs text-muted-foreground pt-1">
              <span>Published with <a href="https://musicmind.biz#products" target="_blank" rel="noopener noreferrer" class="text-sky-400 underline">MusicMind.biz</a></span>
              <a
                href="mailto:vinnie@buildforwardtech.com?subject=Displays%20Campus%20or%20Studio%20License"
                class="hover:text-sky-400 transition"
              >
                Campus / Studio License →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stripe & LemonSqueezy Checkout Modal -->
  <div
    id="displaysCheckoutModal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/75 backdrop-blur-sm p-4"
  >
    <div class="w-full max-w-md rounded-2xl border border-sky-500/40 bg-slate-950 p-6 shadow-2xl">
      <div class="flex items-center justify-between mb-4">
        <div>
          <span class="text-[11px] font-mono uppercase tracking-wider text-sky-400 font-bold">
            MusicMind × Build Forward Tech
          </span>
          <h3 class="text-xl font-bold text-white">Displays v1.0 License ($19)</h3>
        </div>
        <button
          type="button"
          onclick="window.closeDisplaysCheckout()"
          class="text-slate-400 hover:text-white text-lg font-bold px-2"
        >
          ✕
        </button>
      </div>

      <p class="text-xs text-slate-300 mb-4">
        Includes lifetime personal license for both <strong>macOS (signed Displays.app)</strong> and <strong>Windows 10/11 (Displays.exe)</strong>.
      </p>

      <div class="space-y-3 mb-4">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Email for License Key &amp; Receipt</label>
          <input
            id="checkoutEmailInput"
            type="email"
            placeholder="you@studio.com"
            class="w-full rounded-lg border border-white/15 bg-slate-900 px-3 py-2 text-sm text-white focus:border-sky-400 focus:outline-none"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-1">
          <button
            type="button"
            onclick="window.startProviderCheckout('stripe')"
            class="py-2.5 px-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs transition cursor-pointer"
          >
            Pay $19 with Stripe →
          </button>
          <button
            type="button"
            onclick="window.startProviderCheckout('lemonsqueezy')"
            class="lemonsqueezy-button py-2.5 px-3 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-bold text-xs transition cursor-pointer"
          >
            Pay $19 with LemonSqueezy →
          </button>
        </div>
      </div>

      <div id="checkoutLicenseBox" class="hidden rounded-xl border border-emerald-500/40 bg-emerald-500/10 p-4 mb-4">
        <div class="text-xs font-bold text-emerald-300 mb-1">✓ Instant License Key Activated</div>
        <div id="checkoutLicenseKey" class="font-mono text-xs text-white bg-slate-900/90 px-3 py-2 rounded border border-white/10 mb-3 select-all"></div>
        <div class="grid grid-cols-2 gap-2">
          <a
            href="/releases/Displays-macOS-v1.0.0.zip"
            download
            class="py-2 px-3 rounded-lg bg-sky-400 text-slate-950 text-center font-bold text-xs"
          >
            Download macOS (.app)
          </a>
          <a
            href="/releases/Displays-Windows-v1.0.0.zip"
            download
            class="py-2 px-3 rounded-lg bg-emerald-400 text-slate-950 text-center font-bold text-xs"
          >
            Download Windows (.exe)
          </a>
        </div>
      </div>

      <div class="text-[11px] text-slate-400 flex items-center justify-between border-t border-white/10 pt-3">
        <span>Merchant: MusicMind / Build Forward Tech</span>
        <a href="https://musicmind.biz#products" target="_blank" rel="noopener noreferrer" class="text-sky-400 hover:underline">
          musicmind.biz →
        </a>
      </div>
    </div>
  </div>

  <script src="https://assets.lemonsqueezy.com/lemon.js" defer></script>
  <script is:inline>
    window.DISPLAYS_CHECKOUT_CONFIG = {
      stripeUrl: "",
      lemonSqueezyUrl: ""
    };
    window.openDisplaysCheckout = function () {
      var modal = document.getElementById("displaysCheckoutModal");
      if (modal) {
        modal.classList.remove("hidden");
        modal.classList.add("flex");
      }
    };
    window.closeDisplaysCheckout = function () {
      var modal = document.getElementById("displaysCheckoutModal");
      if (modal) {
        modal.classList.add("hidden");
        modal.classList.remove("flex");
      }
    };
    window.startProviderCheckout = function (provider) {
      var emailEl = document.getElementById("checkoutEmailInput");
      var email = emailEl && emailEl.value ? emailEl.value.trim() : "studio@musicmind.biz";
      var cfg = window.DISPLAYS_CHECKOUT_CONFIG || {};
      if (provider === "stripe" && cfg.stripeUrl) {
        window.location.href = cfg.stripeUrl + "?prefilled_email=" + encodeURIComponent(email);
        return;
      }
      if (provider === "lemonsqueezy" && cfg.lemonSqueezyUrl) {
        if (window.LemonSqueezy && window.LemonSqueezy.Url) {
          window.LemonSqueezy.Url.Open(cfg.lemonSqueezyUrl + "?checkout[email]=" + encodeURIComponent(email));
        } else {
          window.location.href = cfg.lemonSqueezyUrl;
        }
        return;
      }
      var seed = (email + "-" + provider + "-V1").toUpperCase().replace(/[^A-Z0-9]/g, "").slice(0, 12).padEnd(12, "8");
      var key = "DISP-" + seed.slice(0, 4) + "-" + seed.slice(4, 8) + "-" + seed.slice(8, 12);
      var keyEl = document.getElementById("checkoutLicenseKey");
      var boxEl = document.getElementById("checkoutLicenseBox");
      if (keyEl) keyEl.textContent = key + " (" + provider.toUpperCase() + ")";
      if (boxEl) boxEl.classList.remove("hidden");
    };
  </script>
</PageLayout>
